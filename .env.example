APP_NAME=Rezifa AI
APP_VERSION=1.0.0
DEBUG=True

# Use the Supabase PostgreSQL connection string with an asyncpg driver.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Replace every placeholder with your own project credentials.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=devdocs-documents

# Gemini embeddings are used for document processing and chat retrieval.
GEMINI_API_KEY=your-gemini-api-key

# Choose "ollama" or "gemini" for answer generation.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
